APP_NAME=OneShop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=hr
APP_FALLBACK_LOCALE=hr
APP_FAKER_LOCALE=hr_HR
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=oneshop
DB_USERNAME=oneshop
DB_PASSWORD=oneshop_local

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=shop@example.test
MAIL_FROM_NAME=OneShop
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

FILESYSTEM_DISK=local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Test/local values only. Production secrets must be supplied separately.
VITE_APP_NAME=OneShop

# Prepared storefront layouts: everyday, atelier, studio, market.
ONESHOP_THEME=everyday


# Development-only simulator. Production is rejected even when this is true.
ONESHOP_DEMO_CHECKOUT=false

# Stripe sandbox only, additionally blocked outside local/testing.
ONESHOP_STRIPE_SANDBOX=false
STRIPE_TEST_ACCOUNT_ID=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
