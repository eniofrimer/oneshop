{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "eniofrimer/oneshop",
    "type": "project",
    "description": "Managed storefront application with an independent Filament administration panel.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-bcmath": "*",
        "ext-exif": "*",
        "ext-intl": "*",
        "ext-pdo": "*",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "brick/money": "^0.15.2",
        "filament/filament": "^5.11",
        "filament/spatie-laravel-media-library-plugin": "^5.11",
        "filament/spatie-laravel-settings-plugin": "^5.11",
        "laravel/fortify": "^1.41",
        "laravel/framework": "^13.39",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "league/csv": "^9.28",
        "lunarphp/core": "^1.5",
        "paypal/paypal-server-sdk": "^2.4",
        "spatie/laravel-activitylog": "^4.12.3",
        "spatie/laravel-medialibrary": "^11.23.11",
        "spatie/laravel-model-states": "^2.14.2",
        "spatie/laravel-permission": "^8.3.2",
        "spatie/laravel-settings": "^3.10",
        "spatie/laravel-sitemap": "^8.2",
        "spatie/laravel-translatable": "^6.15",
        "stripe/stripe-php": "^22.0.1",
        "symfony/filesystem": "^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/horizon": "^5.50.1",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "ext-pdo_pgsql": "Required for PostgreSQL deployments.",
        "ext-pdo_mysql": "Required for MariaDB deployments."
    }
}
