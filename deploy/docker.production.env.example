# Used by Docker Compose interpolation; do not put secrets in this file.
# Application and DB secrets are individual files under deploy/secrets.
APP_URL=https://shop.example.com
ONESHOP_IMAGE_TAG=replace_with_release_commit
ONESHOP_RELEASE_PORT=8088
ONESHOP_THEME=everyday
ONESHOP_DISPLAY_TIMEZONE=Europe/Zagreb
# Explicit public launch only; leave false for previews and staging.
ONESHOP_ALLOW_INDEXING=false
DB_DATABASE=oneshop
DB_USERNAME=oneshop
MAIL_MAILER=log
MAIL_FROM_ADDRESS=shop@example.com
