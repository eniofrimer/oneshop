APP_NAME=OneShop
ONESHOP_THEME=everyday
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://shop.example.com
APP_LOCALE=hr
APP_FALLBACK_LOCALE=hr
APP_FAKER_LOCALE=en_US

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=replace_database_name
DB_USERNAME=replace_database_user
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
ONESHOP_QUEUE_VIA_SCHEDULER=true
ONESHOP_SEARCH_EXTENSIONS=false

LOG_CHANNEL=daily
LOG_LEVEL=warning
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=shop@example.com
MAIL_FROM_NAME=OneShop
